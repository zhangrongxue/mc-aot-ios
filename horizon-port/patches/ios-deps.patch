 }
 
+/// iOS startup: the app has no command line, so the shell supplies the resource
+/// directory and the writable game directory. The synthetic command line is
+/// accepted by the same parser the desktop executable uses.
+pub fn prepare_ios(resources: PathBuf, game_dir: PathBuf) -> Result<Startup, String> {
+    let exe = std::env::current_exe().map_err(|error| error.to_string())?;
+    let mut command = std::process::Command::new(exe);
+    command
+        .arg("--resources")
+        .arg(resources)
+        .arg("--game-dir")
+        .arg(game_dir)
+        .arg("--developer-single-player")
+        .arg("--no-pause");
+    let launch =
+        LaunchArguments::for_command(&command).map_err(|error| error.to_string())?;
+    let options = game::Options::validate(launch.clone())
+        .map_err(|error| error.to_string())?
+        .ok_or_else(|| "iOS startup cannot use --help".to_owned())?;
+    Ok(Startup {
+        launch,
+        options,
+        _capture: None,
+    })
+}
+
 /// Refuse startup if any merged copy could not be installed, before loading any mod.
 /// Cells cannot roll back: each copy merges all requesting rows, so stopping the whole
 /// start is how we ensure none of a refused mod's rows run.
